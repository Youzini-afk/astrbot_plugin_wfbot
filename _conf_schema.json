{
  "public_export_language": {
    "type": "string",
    "default": "zh",
    "options": ["zh", "en"],
    "description": "PublicExport 语言",
    "hint": "用于下载官方 PublicExport（index_<lang>.txt.lzma）；建议与使用场景一致：中文=zh，英文=en。"
  },
  "refresh": {
    "type": "object",
    "description": "刷新间隔（秒）",
    "items": {
      "worldstate": {
        "type": "int",
        "default": 600,
        "description": "WorldState 刷新间隔（秒）",
        "hint": "Warframe 世界状态（活动/裂缝/入侵等）数据刷新频率；过小可能触发限流。"
      },
      "public_export": {
        "type": "int",
        "default": 21600,
        "description": "PublicExport 刷新间隔（秒）",
        "hint": "官方静态数据（物品/词条等）更新频率较低，建议 6~24 小时。"
      },
      "mirrors": {
        "type": "int",
        "default": 21600,
        "description": "镜像数据源刷新间隔（秒）",
        "hint": "NyxBot 风格的多镜像 JSON 数据（节点名、翻译等）。"
      },
      "market_bootstrap": {
        "type": "int",
        "default": 86400,
        "description": "warframe.market 列表数据刷新间隔（秒）",
        "hint": "用于预拉取 market 的 items 等基础数据；不建议过于频繁。"
      }
    }
  },
  "http": {
    "type": "object",
    "description": "网络与代理",
    "items": {
      "proxy_url": {
        "type": "string",
        "default": "",
        "description": "强制使用代理（可选）",
        "hint": "填写完整代理地址，如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7890。留空则使用系统环境代理。"
      },
      "max_request_time_seconds": {
        "type": "int",
        "default": 30,
        "description": "单次请求最长耗时（秒）",
        "hint": "包含重试在内的总耗时上限；到达上限会抛出异常并在下次刷新再试。"
      },
      "no_proxy_enabled": {
        "type": "bool",
        "default": true,
        "description": "对部分域名禁用系统代理（NyxBot 风格）",
        "hint": "NyxBot 默认对 *.warframe.com 直连（trust_env=false）。如果你的网络环境必须走代理才能访问 warframe.com，请关闭该选项。"
      },
      "no_proxy_suffixes": {
        "type": "list",
        "default": ["warframe.com", "warframestat.us"],
        "description": "直连域名后缀列表",
        "hint": "仅在开启“禁用系统代理”时生效；命中后缀的域名将直连（不使用系统代理）。"
      }
    }
  },
  "log": {
    "type": "object",
    "description": "日志开关",
    "items": {
      "enabled": {
        "type": "bool",
        "default": true,
        "description": "日志总开关",
        "hint": "关闭后将屏蔽本插件所有日志输出。"
      },
      "main_enabled": {
        "type": "bool",
        "default": true,
        "description": "主流程日志",
        "hint": "控制插件主流程/指令相关日志。"
      },
      "manager_enabled": {
        "type": "bool",
        "default": true,
        "description": "数据管理日志",
        "hint": "控制数据刷新与后台循环相关日志。"
      },
      "http_enabled": {
        "type": "bool",
        "default": true,
        "description": "HTTP 日志",
        "hint": "控制网络请求与代理回退相关日志。"
      },
      "public_export_enabled": {
        "type": "bool",
        "default": true,
        "description": "PublicExport 日志",
        "hint": "控制 PublicExport 下载/解压相关日志。"
      },
      "cache_enabled": {
        "type": "bool",
        "default": true,
        "description": "缓存日志",
        "hint": "控制缓存读写相关日志。"
      },
      "subscription_enabled": {
        "type": "bool",
        "default": true,
        "description": "订阅日志",
        "hint": "控制订阅存储/推送相关日志。"
      },
      "cycle_enabled": {
        "type": "bool",
        "default": true,
        "description": "cycles 日志总开关",
        "hint": "关闭后将屏蔽所有 cycles 相关日志（成功/失败/回退）。"
      },
      "cycle_fetch_failures": {
        "type": "bool",
        "default": true,
        "description": "记录 cycles 拉取失败日志",
        "hint": "关闭后将不再输出 cycle_* fetch failed 的 WARN 日志。"
      },
      "cycle_fetch_success": {
        "type": "bool",
        "default": true,
        "description": "记录 cycles 拉取成功与回退日志",
        "hint": "关闭后将不再输出 cycles 拉取/回退的 INFO/DEBUG 日志。"
      }
    }
  },
  "sources": {
    "type": "object",
    "description": "数据源策略",
    "items": {
      "use_warframestat_endpoints": {
        "type": "bool",
        "default": true,
        "description": "使用 warframestat 子端点（arbitration/voidStorms 等）",
        "hint": "关闭后将不请求 warframestat 的具体端点，仅使用 root worldstate/官方源。"
      },
      "use_warframestat_root": {
        "type": "bool",
        "default": true,
        "description": "使用 warframestat root worldstate 补全",
        "hint": "当官方 worldstate 字段缺失时，用 warframestat root 补全。"
      },
      "warframestat_base_url": {
        "type": "string",
        "default": "https://api.warframestat.us",
        "description": "warframestat API 基础地址（无需带 /pc）",
        "hint": "当默认域名不可用时可改为自建镜像或代理地址。"
      },
      "warframestat_mirror_urls": {
        "type": "list",
        "description": "warframestat 备选镜像地址（按顺序尝试）",
        "default": [],
        "hint": "支持多个镜像；每个地址无需带 /pc。",
        "items": {
          "type": "string"
        }
      },
      "warframestat_root_file": {
        "type": "string",
        "default": "",
        "description": "本地 warframestat root worldstate JSON 文件路径",
        "hint": "用于手工补全（如仲裁/九重天）。支持相对路径，默认会尝试 ./worldstate/warframestat_root.json。"
      },
      "extras_cache_ttl_seconds": {
        "type": "int",
        "default": 120,
        "description": "补全数据缓存时间（秒）",
        "hint": "减少对 warframestat 的请求频率。"
      }
    }
  },
  "retention": {
    "type": "object",
    "description": "存储与清理",
    "items": {
      "cleanup_days": {
        "type": "int",
        "default": 14,
        "description": "保留天数（快照/缓存/图片缓存）",
        "hint": "清理策略：删除超过该天数的历史快照/缓存文件。"
      },
      "keep_worldstate_snapshots": {
        "type": "int",
        "default": 24,
        "description": "WorldState 快照保留数量",
        "hint": "每次 worldstate 更新会保存一个快照；超过数量会自动裁剪。"
      },
      "keep_mirror_snapshots": {
        "type": "int",
        "default": 10,
        "description": "每个 mirror 数据集快照保留数量",
        "hint": "对每个镜像数据集分别保留 N 份历史快照。"
      }
    }
  },
  "render": {
    "type": "object",
    "description": "图片渲染",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "将 /wf 输出渲染为图片",
        "hint": "开启后，文本会本地渲染成 PNG 发送；适合长文本/排版。"
      },
      "cache_images": {
        "type": "bool",
        "default": false,
        "description": "缓存渲染后的图片到磁盘",
        "hint": "开启后，相同内容会复用缓存图片（节省渲染耗时，增加磁盘占用）。"
      },
      "keep_images": {
        "type": "int",
        "default": 10,
        "description": "图片缓存保留数量",
        "hint": "仅在开启图片缓存时生效；超过数量会自动裁剪。"
      },
      "width": {
        "type": "int",
        "default": 1080,
        "description": "图片宽度（像素）",
        "hint": "宽度越大越不容易换行，但图片更大；建议 900~1400。"
      },
      "font_size": {
        "type": "int",
        "default": 32,
        "description": "正文字号（像素）",
        "hint": "默认字体会自动探测系统字体；字号过大可能导致图片过高。"
      },
      "title_font_size": {
        "type": "int",
        "default": 40,
        "description": "标题字号（像素）",
        "hint": "图片第一行标题字号。"
      },
      "pad": {
        "type": "int",
        "default": 28,
        "description": "内边距（像素）",
        "hint": "图片四周留白。"
      },
      "line_gap": {
        "type": "int",
        "default": 10,
        "description": "行间距（像素）",
        "hint": "每行之间的间隔。"
      },
      "font_cjk": {
        "type": "string",
        "default": "",
        "description": "中文字体文件路径（可选）",
        "hint": "留空则自动探测（Windows 常用：C:\\\\Windows\\\\Fonts\\\\msyh.ttc / simhei.ttf）。"
      },
      "font_emoji": {
        "type": "string",
        "default": "",
        "description": "Emoji 字体文件路径（可选）",
        "hint": "留空则自动探测（Windows 常用：C:\\\\Windows\\\\Fonts\\\\seguiemj.ttf）。"
      },
      "emoji_mode": {
        "type": "string",
        "default": "replace",
        "options": ["replace", "keep", "strip"],
        "description": "图片模式下 Emoji 处理方式",
        "hint": "replace=将常用 emoji 替换为可渲染符号并移除其余；keep=尽量保留（可能出现方块/乱码，取决于系统字体）；strip=直接移除。"
      }
    }
  },
  "subscriptions": {
    "type": "object",
    "description": "订阅推送",
    "items": {
      "cycles_default_offset_minutes": {
        "type": "int",
        "default": 0,
        "description": "平原/循环订阅默认提前/后置分钟数（>0 提前，<0 后置）",
        "hint": "当你执行“/wf 订阅 夜灵平原 夜晚”且未指定时间（如 10/提前10/后置10）时，使用此默认值；0 表示仅在指令显式指定时才提醒。"
      },
      "notify_mode_default": {
        "type": "string",
        "default": "change",
        "options": ["change", "new_only"],
        "description": "订阅通知策略默认值",
        "hint": "change=订阅内容有变化就通知；new_only=仅新出现条目才通知。"
      },
      "notify_modes": {
        "type": "object",
        "description": "按类型覆盖通知策略",
        "items": {
          "alerts": {
            "type": "string",
            "default": "new_only",
            "options": ["change", "new_only"],
            "description": "警报通知策略"
          },
          "invasions": {
            "type": "string",
            "default": "new_only",
            "options": ["change", "new_only"],
            "description": "入侵通知策略"
          },
          "fissures": {
            "type": "string",
            "default": "new_only",
            "options": ["change", "new_only"],
            "description": "裂缝通知策略"
          },
          "daily_deals": {
            "type": "string",
            "default": "new_only",
            "options": ["change", "new_only"],
            "description": "每日特惠通知策略"
          },
          "arbitration": {
            "type": "string",
            "default": "new_only",
            "options": ["change", "new_only"],
            "description": "仲裁通知策略"
          },
          "void_trader": {
            "type": "string",
            "default": "new_only",
            "options": ["change", "new_only"],
            "description": "奸商通知策略"
          },
          "steel_path": {
            "type": "string",
            "default": "new_only",
            "options": ["change", "new_only"],
            "description": "钢铁奖励通知策略"
          },
          "sortie": {
            "type": "string",
            "default": "change",
            "options": ["change", "new_only"],
            "description": "突击通知策略"
          },
          "archon": {
            "type": "string",
            "default": "change",
            "options": ["change", "new_only"],
            "description": "执刑官猎杀通知策略"
          },
          "cycles": {
            "type": "string",
            "default": "change",
            "options": ["change", "new_only"],
            "description": "平原/循环通知策略"
          },
          "duviri": {
            "type": "string",
            "default": "change",
            "options": ["change", "new_only"],
            "description": "轮换通知策略"
          },
          "nightwave": {
            "type": "string",
            "default": "change",
            "options": ["change", "new_only"],
            "description": "电波通知策略"
          }
        }
      }
    }
  },
  "admin": {
    "type": "object",
    "description": "管理员扩展（保留 AstrBot 管理员判定）",
    "items": {
      "group_admins": {
        "type": "list",
        "default": [],
        "description": "按群配置管理员",
        "hint": "列表项示例：{\"group_id\": \"123456\", \"admins\": [\"111\", \"222\"]}"
      },
      "session_admins": {
        "type": "list",
        "default": [],
        "description": "按会话配置管理员（高级）",
        "hint": "列表项示例：{\"session\": \"<unified_msg_origin>\", \"admins\": [\"111\", \"222\"]}"
      }
    }
  },
  "i18n": {
    "type": "object",
    "description": "语言与显示",
    "items": {
      "simplify_zh": {
        "type": "bool",
        "default": true,
        "description": "将繁体中文转换为简体中文",
        "hint": "部分第三方数据源（如 warframestat solNodes）返回繁体；开启后会使用 OpenCC(t2s) 在本地转换。"
      }
    }
  },
  "store_user_name": {
    "type": "bool",
    "default": true,
    "description": "订阅存储用户名",
    "hint": "关闭后不再在订阅存储中保存用户昵称。"
  },
  "store_platform": {
    "type": "bool",
    "default": true,
    "description": "订阅存储平台信息",
    "hint": "关闭后不再保存平台字段。"
  },
  "store_group_id": {
    "type": "bool",
    "default": true,
    "description": "订阅存储群号",
    "hint": "关闭后不再保存群号（可能影响 @ 提醒）。"
  },

  "worldstate_refresh_interval": {
    "type": "int",
    "default": 600,
    "description": "(deprecated) use refresh.worldstate",
    "invisible": true
  },
  "public_export_refresh_interval": {
    "type": "int",
    "default": 21600,
    "description": "(deprecated) use refresh.public_export",
    "invisible": true
  },
  "mirrors_refresh_interval": {
    "type": "int",
    "default": 21600,
    "description": "(deprecated) use refresh.mirrors",
    "invisible": true
  },
  "market_bootstrap_refresh_interval": {
    "type": "int",
    "default": 86400,
    "description": "(deprecated) use refresh.market_bootstrap",
    "invisible": true
  },
  "cleanup_retention_days": {
    "type": "int",
    "default": 14,
    "description": "(deprecated) use retention.cleanup_days",
    "invisible": true
  },
  "keep_worldstate_snapshots": {
    "type": "int",
    "default": 24,
    "description": "(deprecated) use retention.keep_worldstate_snapshots",
    "invisible": true
  },
  "keep_mirror_snapshots": {
    "type": "int",
    "default": 10,
    "description": "(deprecated) use retention.keep_mirror_snapshots",
    "invisible": true
  },
  "image_mode": {
    "type": "bool",
    "default": false,
    "description": "(deprecated) use render.enabled",
    "invisible": true
  },
  "cache_images": {
    "type": "bool",
    "default": false,
    "description": "(deprecated) use render.cache_images",
    "invisible": true
  },
  "keep_image_cache": {
    "type": "int",
    "default": 10,
    "description": "(deprecated) use render.keep_images",
    "invisible": true
  },
  "log_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.enabled",
    "invisible": true
  },
  "log_main_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.main_enabled",
    "invisible": true
  },
  "log_manager_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.manager_enabled",
    "invisible": true
  },
  "log_http_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.http_enabled",
    "invisible": true
  },
  "log_public_export_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.public_export_enabled",
    "invisible": true
  },
  "log_cache_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.cache_enabled",
    "invisible": true
  },
  "log_subscription_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.subscription_enabled",
    "invisible": true
  },
  "log_cycle_enabled": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.cycle_enabled",
    "invisible": true
  },
  "log_cycle_fetch_failures": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.cycle_fetch_failures",
    "invisible": true
  },
  "log_cycle_fetch_success": {
    "type": "bool",
    "default": true,
    "description": "(deprecated) use log.cycle_fetch_success",
    "invisible": true
  }
}
